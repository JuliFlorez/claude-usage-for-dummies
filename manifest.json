{
  "manifest_version": 3,
  "name": "Claude Usage for Dummies",
  "version": "0.6.0",
  "description": "Your claude.ai usage limits at a glance: in the toolbar icon, a side panel and right below the chat.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Claude Usage for Dummies" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://claude.ai/*"],
    "js": ["i18n.js", "context.js", "content.js"],
    "run_at": "document_idle"
  }],
  "permissions": ["sidePanel", "storage", "alarms", "cookies", "scripting"],
  "host_permissions": ["https://claude.ai/*"]
}
